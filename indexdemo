function intakeHTML(){return `<h3 class="no-print">New Vehicle Intake / Auto Body Invoice</h3><p class="no-print">Nhập số vào các ô giờ và tiền, hệ thống tự tính tổng. Bấm Print A4 Report để in.</p><div class="sheet"><div class="title">HUYS AUTO BODY & PAINTING LLC</div><div class="info">13932 Seaboard Cir., Garden Grove, CA 92843- (714) 589-7779 - huysautobody@gmail.com</div><div class="row r3"><div class="cell"><b>ESTIMATE #:</b><input placeholder="CP1595"></div><div class="cell"><b>RO#</b><input placeholder="2605891"></div><div class="cell"><b>DATE:</b><input type="date"></div></div><div class="row r2"><div><div class="cell"><b>Name:</b><input placeholder="Customer name"></div><div class="cell"><b>phone:</b><input placeholder="Phone"></div><div class="cell"><b>email:</b><input placeholder="Email"></div></div><div><div class="cell"><input class="veh" placeholder="2025 Ford Explorer ST"></div><div class="row r3"><div class="cell"><b>Lic:</b><input></div><div class="cell"><b>Miles:</b><input></div><div class="cell"><b>Color:</b><input placeholder="white pearl"></div></div><div class="cell"><b>Vin:</b><input></div></div></div><table class="lines"><thead><tr><th>Line</th><th>Opera</th><th>Parts Description</th><th>Part Number</th><th>Qty</th><th>Ext Price</th><th>Frame</th><th>mechanic</th><th>Body</th><th>Pnt Sply</th><th>Paint</th></tr></thead><tbody id="lineItems"></tbody></table><div class="row r2"><div class="cell"><b>Vehicle Released :</b></div><div class="cell"><b>Sign:</b></div></div><div class="no-print"><button onclick="addLine()">+ Add Line</button><button onclick="removeLine()">- Remove Line</button></div><table class="money"><tr><th>Category</th><th>Basis hrs.</th><th></th><th>Rate /hrs.</th><th>Cost $</th></tr><tr><td class="left bold">Parts</td><td></td><td></td><td></td><td><input id="partsTotal" value="0" oninput="calcTotals()" class="right"></td></tr><tr><td class="left bold">Frame Labor</td><td><input id="frameHrs" value="0" oninput="calcTotals()"></td><td>@</td><td><input id="frameRate" value="150" oninput="calcTotals()"></td><td id="frameCost" class="right">$0.00</td></tr><tr><td class="left bold">Mechanic Labor</td><td><input id="mechHrs" value="0" oninput="calcTotals()"></td><td>@</td><td><input id="mechRate" value="180" oninput="calcTotals()"></td><td id="mechCost" class="right">$0.00</td></tr><tr><td class="left bold">Body Labor</td><td><input id="bodyHrs" value="0" oninput="calcTotals()"></td><td>@</td><td><input id="bodyRate" value="110" oninput="calcTotals()"></td><td id="bodyCost" class="right">$0.00</td></tr><tr><td class="left bold">Paint Supplies</td><td><input id="supplyHrs" value="0" oninput="calcTotals()"></td><td>@</td><td><input id="supplyRate" value="85" oninput="calcTotals()"></td><td id="supplyCost" class="right">$0.00</td></tr><tr><td class="left bold">Paint Labor</td><td><input id="paintHrs" value="0" oninput="calcTotals()"></td><td>@</td><td><input id="paintRate" value="85" oninput="calcTotals()"></td><td id="paintCost" class="right">$0.00</td></tr><tr><td class="left bold">Miscellaneous</td><td></td><td></td><td></td><td><input id="miscCost" value="0" oninput="calcTotals()" class="right"></td></tr><tr><td colspan="3"></td><td class="bold right">SUB TOTAL</td><td id="subTotal" class="right bold">$0.00</td></tr><tr><td class="left bold">Sales Tax</td><td colspan="2"></td><td><input id="taxBase" value="0" oninput="calcTotals()"> @ <input id="taxRate" value="8.75" oninput="calcTotals()" style="width:55px">%</td><td id="taxAmount" class="right">$0.00</td></tr><tr><td colspan="3" class="left bold big">Total Cost of Repairs</td><td class="bold right">TOTAL</td><td id="grandTotal" class="right big">$0.00</td></tr><tr><td colspan="3" class="left bold">P/S: <input placeholder="1 year warranty of paint"></td><td class="bold right">Cash Deal</td><td><input id="cashDeal" oninput="calcTotals()" class="right"></td></tr><tr><td colspan="3" class="left bold">*NOTE: <input value="1 year warranty of paint"></td><td class="bold right">Deposit <input id="deposit" value="0" oninput="calcTotals()" style="width:100px"></td><td id="balance" class="right big">$0.00</td></tr></table><div class="bottom"><div><div class="note">The estimate is valid for the next 30 days. Damage caused by theft, fire, or natural disasters is not covered. I hereby authorized --- Power of Attorney to sign over checks. Employees may operate my vehicle for testing, inspection, and delivery at my risk. If I cancel repairs before completion, tear-down/reassembly fees may apply. Storage parking fee will be charged after completed vehicle is not picked up. Warranty period: 1 YEAR for replacement parts - 3 YEAR for paint if peeling or cracked.</div><div class="thanks">Thank You For Your Business!</div></div><div><div class="sign">SIGNATURE<br><br><br><br>DATE:................../................../..................</div></div></div></div><div class="no-print"><button onclick="alert('Vehicle workflow created')">Create Vehicle Workflow</button><button onclick="window.print()">Print A4 Report</button><button onclick="alert('Job slip will print next version')">Print Job Slip</button></div>`}
