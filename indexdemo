function sumLineHours(){let body=0,supply=0,paint=0,frame=0,mech=0,parts=0;document.querySelectorAll("#lineItems tr").forEach(r=>{let i=r.querySelectorAll("input");parts+=money(i[4].value);frame+=money(i[5].value);mech+=money(i[6].value);body+=money(i[7].value);supply+=money(i[8].value);paint+=money(i[9].value)});partsTotal.value=parts;frameHrs.value=frame;mechHrs.value=mech;bodyHrs.value=body;supplyHrs.value=supply;paintHrs.value=paint;calcTotals()}
function calcTotals(){let parts=money(partsTotal.value),frame=money(frameHrs.value)*money(frameRate.value),mech=money(mechHrs.value)*money(mechRate.value),body=money(bodyHrs.value)*money(bodyRate.value),supply=money(supplyHrs.value)*money(supplyRate.value),paint=money(paintHrs.value)*money(paintRate.value),misc=money(miscCost.value),subtotal=parts+frame+mech+body+supply+paint+misc,tax=money(taxBase.value)*money(taxRate.value)/100,total=subtotal+tax,cash=money(cashDeal.value)||total,bal=cash-money(deposit.value);frameCost.innerText=fmt(frame);mechCost.innerText=fmt(mech);bodyCost.innerText=fmt(body);supplyCost.innerText=fmt(supply);paintCost.innerText=fmt(paint);subTotal.innerText=fmt(subtotal);taxAmount.innerText=fmt(tax);grandTotal.innerText=fmt(total);balance.innerText=fmt(bal)}
